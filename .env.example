GROQ_API_KEY=your_groq_api_key_here

# Model used for grounded answer synthesis and the research pipeline's
# write/review steps.
GROQ_MODEL=openai/gpt-oss-120b

# Groq's model lineup changes over time. If you hit a 404 model_not_found
# error, list what's actually available on your account with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"

# Enables the /api/research endpoint's web-search step (get a key at
# tavily.com). Everything else — /api/query, /api/ingest/*, and /api/research
# with use_web:false — works fine without this.
TAVILY_API_KEY=

# Optional: gates every route except /health behind HTTP Basic Auth (any
# username, this password). Leave empty for local dev. Set this on any
# public deployment, since a public URL otherwise lets anyone burn your
# Groq quota.
APP_PASSWORD=

# Chunking and retrieval tuning (sane defaults, override only if needed).
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# TOP_K=4
# MIN_RELEVANCE_SCORE=0.05
# MAX_RESEARCH_REVISIONS=1
